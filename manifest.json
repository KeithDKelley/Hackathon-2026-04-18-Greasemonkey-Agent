{
  "manifest_version": 2,
  "name": "Greasemonkey Agent",
  "version": "1.0.0",
  "description": "Chat with Claude to generate and run scripts that modify the current page.",
  "permissions": ["activeTab", "storage", "tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "sidebar_action": {
    "default_title": "Greasemonkey Agent",
    "default_panel": "sidepanel.html"
  },
  "browser_action": {
    "default_title": "Open Greasemonkey Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "greasemonkey-agent@keithkelley.dev",
      "strict_min_version": "109.0"
    }
  }
}
