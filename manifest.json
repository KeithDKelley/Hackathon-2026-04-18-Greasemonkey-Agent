{
  "manifest_version": 3,
  "name": "Greasemonkey Agent",
  "version": "1.0.0",
  "description": "Chat with Claude to generate and run scripts that modify the current page.",
  "permissions": ["sidePanel", "scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Greasemonkey Agent",
    "default_panel": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Greasemonkey Agent"
  },
  "options_page": "settings.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "greasemonkey-agent@keithkelley.dev",
      "strict_min_version": "109.0"
    }
  }
}
